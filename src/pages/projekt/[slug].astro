---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectDetail from '../../components/projects/ProjectDetail.astro';
import { resolveExistingPublicAsset } from '../../lib/public-assets';

export async function getStaticPaths() {
  const projects = await getCollection('projects');

  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const ogImage = resolveExistingPublicAsset(project.data.caseImage);
const breadcrumbs = [
  { name: 'Hem', path: '/' },
  { name: 'Projekt', path: '/projekt/' },
  { name: project.data.title, path: `/projekt/${project.slug}/` },
];
---

<BaseLayout
  title={`${project.data.title} | Projekt`}
  description={project.data.excerpt}
  lang="sv"
  ogType="article"
  ogImage={ogImage}
  structuredData={{ breadcrumbs }}
>
  <ProjectDetail
    lang="sv"
    title={project.data.title}
    excerpt={project.data.excerpt}
    role={project.data.role}
    stack={project.data.stack}
    tags={project.data.tags}
    outcomes={project.data.outcomes}
    liveUrl={project.data.liveUrl}
    repoUrl={project.data.repoUrl}
    caseImage={ogImage}
    backHref="/projekt/"
    backLabel="<- Tillbaka till projekt"
    contactHref="/kontakt/"
    contactLabel="Kontakta mig"
    ctaTitle="Vill du bygga ett liknande system?"
    ctaText="Beskriv ditt nuläge så återkommer jag med rekommenderad plan och tydliga nästa steg."
  >
    <Content />
  </ProjectDetail>
</BaseLayout>
