---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectDetail from '../../components/projects/ProjectDetail.astro';
import { resolveExistingPublicAsset } from '../../lib/public-assets';
import { buildProjectSeoTitle } from '../../lib/seo';

export async function getStaticPaths() {
  const projects = await getCollection('projects');

  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const ogImage = resolveExistingPublicAsset(project.data.caseImage);
const breadcrumbs = [
  { name: 'Hem', path: '/' },
  { name: 'Projekt', path: '/projekt/' },
  { name: project.data.title, path: `/projekt/${project.slug}/` },
];
---

<BaseLayout
  title={buildProjectSeoTitle({
    lang: 'sv',
    slug: project.slug,
    title: project.data.title,
    role: project.data.role,
    tags: project.data.tags,
  })}
  description={project.data.excerpt}
  lang="sv"
  ogType="article"
  ogImage={ogImage}
  structuredData={{ breadcrumbs }}
>
  <ProjectDetail
    lang="sv"
    title={project.data.title}
    excerpt={project.data.excerpt}
    role={project.data.role}
    stack={project.data.stack}
    tags={project.data.tags}
    outcomes={project.data.outcomes}
    liveUrl={project.data.liveUrl}
    repoUrl={project.data.repoUrl}
    caseImage={ogImage}
    projectType={project.data.projectType}
    skills={project.data.skills}
    tracks={project.data.tracks}
    purpose={project.data.purpose}
    myRole={project.data.myRole}
    keyParts={project.data.keyParts}
    methods={project.data.methods}
    demonstrates={project.data.demonstrates}
    employmentRelevance={project.data.employmentRelevance}
    screenshots={project.data.screenshots}
    backHref="/projekt/"
    backLabel="<- Tillbaka till projekt"
    contactHref="/kontakt/"
    contactLabel="Kontakta mig"
    ctaTitle="Vill du se hur projektet kopplar till min profil?"
    ctaText="Kontakta mig om du rekryterar till en roll där den här typen av struktur, implementation och problemlösning är relevant."
  >
    <Content />
  </ProjectDetail>
</BaseLayout>
