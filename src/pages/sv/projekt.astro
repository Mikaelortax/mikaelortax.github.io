---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectProofIndex from '../../components/projects/ProjectProofIndex.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort((a, b) => {
  if (a.data.featured !== b.data.featured) {
    return a.data.featured ? -1 : 1;
  }
  return a.data.title.localeCompare(b.data.title, 'sv');
});

const breadcrumbs = [
  { name: 'Hem', path: '/' },
  { name: 'Projekt', path: '/sv/projekt' },
];
---

<BaseLayout
  title="Projekt som visar hur jag arbetar"
  description="Projekt som visar praktisk kompetens inom SEO, webb, CMS, AI, automation och digitala arbetsflöden."
  lang="sv"
  structuredData={{ breadcrumbs }}
>
  <ProjectProofIndex lang="sv" projects={projects} />
</BaseLayout>
