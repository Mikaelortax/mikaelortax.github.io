---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProjectDetail from '../../../components/projects/ProjectDetail.astro';
import { resolveExistingPublicAsset } from '../../../lib/public-assets';
import { buildProjectSeoTitle } from '../../../lib/seo';

export async function getStaticPaths() {
  const projects = await getCollection('projects-en');

  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const ogImage = resolveExistingPublicAsset(project.data.caseImage);
const breadcrumbs = [
  { name: 'Home', path: '/en/' },
  { name: 'Projects', path: '/en/projects/' },
  { name: project.data.title, path: `/en/projects/${project.slug}/` },
];
---

<BaseLayout
  title={buildProjectSeoTitle({
    lang: 'en',
    slug: project.slug,
    title: project.data.title,
    role: project.data.role,
    tags: project.data.tags,
  })}
  description={project.data.excerpt}
  lang="en"
  ogType="article"
  ogImage={ogImage}
  structuredData={{ breadcrumbs }}
>
  <ProjectDetail
    lang="en"
    title={project.data.title}
    excerpt={project.data.excerpt}
    role={project.data.role}
    stack={project.data.stack}
    tags={project.data.tags}
    outcomes={project.data.outcomes}
    liveUrl={project.data.liveUrl}
    repoUrl={project.data.repoUrl}
    caseImage={ogImage}
    projectType={project.data.projectType}
    skills={project.data.skills}
    tracks={project.data.tracks}
    purpose={project.data.purpose}
    myRole={project.data.myRole}
    keyParts={project.data.keyParts}
    methods={project.data.methods}
    demonstrates={project.data.demonstrates}
    employmentRelevance={project.data.employmentRelevance}
    screenshots={project.data.screenshots}
    backHref="/en/projects/"
    backLabel="<- Back to projects"
    contactHref="/en/contact/"
    contactLabel="Contact me"
    ctaTitle="Want to discuss how this connects to a role?"
    ctaText="Contact me if you are hiring for a role where this kind of structure, implementation, and problem solving is relevant."
  >
    <Content />
  </ProjectDetail>
</BaseLayout>
