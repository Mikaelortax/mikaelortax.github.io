---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProjectProofIndex from '../../../components/projects/ProjectProofIndex.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects-en')).sort((a, b) => {
  if (a.data.featured !== b.data.featured) {
    return a.data.featured ? -1 : 1;
  }
  return a.data.title.localeCompare(b.data.title, 'en');
});

const breadcrumbs = [
  { name: 'Home', path: '/en' },
  { name: 'Projects', path: '/en/projects' },
];
---

<BaseLayout
  title="Projects that show how I work"
  description="Projects that show practical competence in SEO, web, CMS, AI, automation, and digital workflows."
  lang="en"
  structuredData={{ breadcrumbs }}
>
  <ProjectProofIndex lang="en" projects={projects} />
</BaseLayout>
