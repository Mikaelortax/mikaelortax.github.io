---
import { getCvPdfLinkProps, getProfilePaths } from '../../lib/profile';

interface Props {
  lang?: 'sv' | 'en';
}

const { lang = 'sv' } = Astro.props;
const isEn = lang === 'en';
const paths = getProfilePaths(lang);
const cvPdfLinkProps = getCvPdfLinkProps(lang);
---

<section class="band band--mesh overflow-hidden" aria-labelledby="hero-title">
  <div class="hero-content">
    <p class="section-kicker reveal-block">
      {isEn ? 'SEEKING EMPLOYMENT: SEO + WEB + AUTOMATION' : 'SÖKER ANSTÄLLNING: SEO + WEBB + AUTOMATION'}
    </p>

    <h1 id="hero-title" class="reveal-block reveal-delay-1 mx-auto mt-6 max-w-[56rem] text-4xl font-semibold tracking-tight text-white sm:text-5xl md:text-6xl">
      {
        isEn ? (
          <>
            I'm looking for an employed role within <span class="hero-accent">SEO, web, digital development, or automation</span>.
          </>
        ) : (
          <>
            Jag söker anställning inom <span class="hero-accent">SEO, webb, digital utveckling eller automation</span>.
          </>
        )
      }
    </h1>

    <p class="reveal-block reveal-delay-2 mx-auto mt-7 max-w-[46rem] text-lg leading-relaxed text-neutral-300 sm:text-xl">
      {
        isEn
          ? 'I have long experience combining SEO, web development, technical structure, analytics, and hands-on implementation. My strength is understanding business, users, and technology, and turning that into clearer websites, better digital workflows, and measurable improvements.'
          : 'Jag har lång erfarenhet av att kombinera SEO, webbutveckling, teknisk struktur, analys och praktisk implementation. Min styrka är att förstå både affär, användare och teknik, och omsätta det till tydligare webbplatser, bättre digitala flöden och mer mätbara förbättringar.'
      }
    </p>

    <p class="reveal-block reveal-delay-2 mx-auto mt-4 max-w-[46rem] text-base leading-relaxed text-neutral-300 sm:text-lg">
      {
        isEn
          ? "I'm based in Blekinge, Sweden, and primarily looking for roles where I can contribute within SEO, website management, CMS/WordPress, AI-assisted workflows, automation, growth, or digital coordination. I'm open to on-site, hybrid, or remote employment."
          : 'Jag bor i Blekinge och söker främst roller där jag kan bidra med SEO, webbförvaltning, CMS/WordPress, AI-stödda arbetsflöden, automation, growth eller digital koordinering. Jag är öppen för anställning på plats, hybrid eller remote.'
      }
    </p>

    <div class="reveal-block reveal-delay-3 mt-9 flex flex-wrap justify-center gap-3">
      <a
        href={paths.contact}
        class="btn-primary px-5 py-3 text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-200 focus-visible:ring-offset-2 focus-visible:ring-offset-neutral-950"
      >
        {isEn ? 'Contact me' : 'Kontakta mig'}
      </a>
      <a
        {...cvPdfLinkProps}
        class="btn-secondary px-5 py-3 text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/70 focus-visible:ring-offset-2 focus-visible:ring-offset-neutral-950"
      >
        {isEn ? 'Download CV' : 'Ladda ner CV'}
      </a>
      <a
        href={paths.projects}
        class="btn-secondary px-5 py-3 text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/70 focus-visible:ring-offset-2 focus-visible:ring-offset-neutral-950"
      >
        {isEn ? 'View work examples' : 'Se arbetsexempel'}
      </a>
    </div>

    <p class="mx-auto mt-5 max-w-[46rem] text-sm text-neutral-400">
      {isEn ? 'Looking for my transport and professional driver profile?' : 'Söker du min profil för transport/yrkesförarroller?'}{' '}
      <a href={paths.transport} class="font-semibold text-cyan-300 transition hover:text-cyan-200">
        {isEn ? 'View it here' : 'Se den här'}
      </a>
      .
    </p>

    <ul class="mx-auto mt-9 grid max-w-[56rem] gap-3 text-sm text-neutral-200 sm:grid-cols-2 lg:grid-cols-4" aria-label={isEn ? 'Capability highlights' : 'Kompetenshöjdpunkter'}>
      <li class="pill-chip reveal-card px-4 py-3">Technical SEO / AEO</li>
      <li class="pill-chip reveal-card px-4 py-3">{isEn ? 'Website management / CMS' : 'Webbförvaltning / CMS'}</li>
      <li class="pill-chip reveal-card px-4 py-3">{isEn ? 'AI-assisted workflows' : 'AI-stödda arbetsflöden'}</li>
      <li class="pill-chip reveal-card px-4 py-3">{isEn ? 'Product-oriented implementation' : 'Produktnära implementation'}</li>
    </ul>

    <p class="mx-auto mt-8 max-w-[56rem] text-sm text-neutral-400">
      <span class="font-semibold text-neutral-200">{isEn ? 'Now:' : 'Nu:'}</span>
      {
        isEn
          ? ' Actively looking for an employed role where SEO, web structure, analytics, CMS/WordPress, automation, and AI-assisted workflows meet practical implementation.'
          : ' Söker aktivt en anställning där SEO, webbstruktur, analys, CMS/WordPress, automation och AI-stödda arbetsflöden möter praktisk implementation.'
      }
    </p>

    <p class="mx-auto mt-4 inline-flex items-center gap-2 rounded-full border border-emerald-300/30 bg-emerald-300/10 px-4 py-2 text-xs font-semibold tracking-[0.04em] text-emerald-200">
      <span class="h-1.5 w-1.5 rounded-full bg-emerald-300" aria-hidden="true"></span>
      {isEn ? 'Open to employed roles on-site, hybrid, or remote' : 'Öppen för anställda roller på plats, hybrid eller remote'}
    </p>
  </div>
</section>
