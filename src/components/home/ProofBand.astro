---
interface Props {
  lang?: 'sv' | 'en';
}

const { lang = 'sv' } = Astro.props;
const isEn = lang === 'en';

const experienceHighlights = isEn
  ? [
      {
        id: '01',
        title: '20+ years in SEO & web',
        text: 'Hands-on experience since 2003 across search, web engineering, e-commerce, and growth.',
      },
      {
        id: '02',
        title: 'Agency + in-house + own business',
        text: 'Experience from specialist roles, Head of SEO, agency leadership, product ownership, and running my own business.',
      },
      {
        id: '03',
        title: 'Cross-functional work',
        text: 'Moves between technical SEO, structure, implementation, release, and automation without long handoffs.',
      },
      {
        id: '04',
        title: 'International experience',
        text: 'Work across multiple markets and cross-functional teams in growth environments.',
      },
      {
        id: '05',
        title: 'AI & automation',
        text: 'Builds AI-assisted SEO and automation workflows with focus on quality and scalability.',
      },
      {
        id: '06',
        title: 'From analysis to improvement',
        text: 'Combines analysis, implementation, release, and iteration in one practical work model.',
      },
    ]
  : [
      {
        id: '01',
        title: '20+ år i SEO & web',
        text: 'Praktisk erfarenhet sedan 2003 inom sök, webbutveckling, e-handel och tillväxt.',
      },
      {
        id: '02',
        title: 'Byrå + inhouse + eget',
        text: 'Erfarenhet från specialistroller, Head of SEO, byråledning, produktägande och eget företagande.',
      },
      {
        id: '03',
        title: 'Tvärfunktionellt arbete',
        text: 'Arbetar mellan teknisk SEO, struktur, implementation, release och automation utan långa handoffs.',
      },
      {
        id: '04',
        title: 'Internationell erfarenhet',
        text: 'Arbete mot flera marknader och tvärfunktionella team i tillväxtmiljöer.',
      },
      {
        id: '05',
        title: 'AI & automation',
        text: 'Bygger AI-stödda SEO- och automationsflöden med fokus på kvalitet och skalbarhet.',
      },
      {
        id: '06',
        title: 'Från analys till förbättring',
        text: 'Kombinerar analys, implementation, release och iteration i ett praktiskt arbetssätt.',
      },
    ];
---

<section class="band band--surface" aria-labelledby="proof-title">
  <header class="section-head reveal-block">
    <p class="section-kicker">{isEn ? 'Experience at a glance' : 'Erfarenhet i korthet'}</p>
    <h2 id="proof-title" class="section-title">{isEn ? 'Experience an employer can build on' : 'Erfarenhet en arbetsgivare kan bygga vidare på'}</h2>
    <p class="section-lead">
      {
        isEn
          ? 'A concentrated snapshot of roles and environments showing how I contribute across SEO, web, structure, analytics, and automation.'
          : 'Ett koncentrat av roller och miljöer som visar hur jag bidrar inom SEO, webb, struktur, analys och automation.'
      }
    </p>
  </header>

  <ul class="mt-9 grid gap-4 sm:grid-cols-2 xl:grid-cols-3" aria-label={isEn ? 'Experience highlights' : 'Erfarenhetshöjdpunkter'}>
    {experienceHighlights.map((item) => (
      <li class="ui-card ui-card--interactive proof-card reveal-card p-5 text-left" tabindex="0">
        <div class="proof-topline" aria-hidden="true"></div>
        <p class="proof-index">{item.id}</p>
        <h3 class="mt-2 text-lg font-semibold text-white">{item.title}</h3>
        <p class="mt-2 text-sm text-neutral-300">{item.text}</p>
      </li>
    ))}
  </ul>

  <div class="mt-8 flex justify-center">
    <a
      href={isEn ? '/en/cv/' : '/sv/cv/'}
      class="btn-secondary inline-flex items-center gap-2 px-6 py-3 text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/70 focus-visible:ring-offset-2 focus-visible:ring-offset-neutral-950"
    >
      {isEn ? 'View full CV' : 'Se fullständigt CV'}
      <span aria-hidden="true">-&gt;</span>
    </a>
  </div>
</section>
