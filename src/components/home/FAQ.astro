---
import { itFaqItems } from '../../lib/profile';

interface Props {
  lang?: 'sv' | 'en';
}

const { lang = 'sv' } = Astro.props;
const isEn = lang === 'en';
const items = itFaqItems[lang];
---

<section class="band band--surface" aria-labelledby="faq-title">
  <header class="section-head reveal-block">
    <p class="section-kicker">{isEn ? 'AEO / FAQ' : 'AEO / FAQ'}</p>
    <h2 id="faq-title" class="section-title">
      {isEn ? 'What employers and clients usually want to know' : 'Det här brukar arbetsgivare och uppdragsgivare vilja veta'}
    </h2>
    <p class="section-lead">
      {
        isEn
          ? 'A compact overview of who I am, what I build, and how I work from analysis to implementation.'
          : 'En kompakt översikt över vem jag är, vad jag bygger och hur jag arbetar från analys till implementation.'
      }
    </p>
  </header>

  <div class="mt-10 grid gap-4 md:grid-cols-2">
    {items.map((item) => (
      <article class="ui-card ui-card--interactive reveal-card p-5 text-left" tabindex="0">
        <h3 class="text-lg font-semibold text-white">{item.question}</h3>
        <p class="mt-3 text-sm leading-relaxed text-neutral-300">{item.answer}</p>
      </article>
    ))}
  </div>
</section>
