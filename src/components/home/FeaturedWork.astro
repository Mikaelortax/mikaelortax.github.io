---
interface Props {
  lang?: 'sv' | 'en';
}

const { lang = 'sv' } = Astro.props;
const isEn = lang === 'en';

const content = isEn
  ? {
      kicker: 'Practical proof',
      title: 'Projects that show how I work',
      intro:
        'Alongside my job search, I build personal digital projects to develop and demonstrate my practical skills in SEO, web, AI, automation, CMS, product structure, and digital workflows. These projects show how I take ideas from analysis and structure to working solutions.',
      labels: {
        projectType: 'Personal project',
        proof: 'What it shows',
        skills: 'Skills',
        readMore: 'View case',
      },
      cards: [
        {
          id: '01',
          title: 'Mystnet SaaS / AI Dashboard',
          text:
            'A SaaS and dashboard project where I work with Laravel, AI-assisted features, client portal concepts, live chat/inbox flows, automations, and product-oriented UI/UX.',
          proof:
            'Ability to think in systems, workflows, user roles, and practical implementation.',
          skills: ['Laravel', 'SaaS', 'AI workflows', 'UI/UX', 'Automation', 'Product thinking'],
        },
        {
          id: '02',
          title: 'WordPress Assistant / AI Content Workflow',
          text:
            'An AI-assisted WordPress and Chrome extension concept for content, SEO, metadata, product copy, and CMS workflows.',
          proof:
            'How I combine SEO, WordPress, AI, and practical editorial workflows.',
          skills: ['WordPress', 'SEO', 'AI', 'Chrome extension', 'CMS workflows', 'Content operations'],
        },
        {
          id: '03',
          title: 'Withdrawal Button for WordPress',
          text:
            'A WordPress plugin for managing withdrawal and cancellation requests with admin screens, public forms, email flows, language support, and optional WooCommerce integration.',
          proof:
            'Structured plugin development, user flows, and production-oriented thinking.',
          skills: ['WordPress plugins', 'WooCommerce', 'Admin UX', 'Email workflows', 'Multilingual support'],
        },
        {
          id: '04',
          title: 'Image-layer Product Visualizer',
          text:
            'A custom WordPress plugin for letting users choose an environment and visually test different window sills.',
          proof:
            'Work with image layers, admin editing, frontend rendering, and product-oriented e-commerce functionality.',
          skills: ['WordPress', 'Visual editor', 'Frontend rendering', 'E-commerce UX', 'Product configurator'],
        },
        {
          id: '05',
          title: 'n8n Lead Automation',
          text:
            'A lead generation automation workflow using n8n, Google Sheets, API data, normalization, deduplication, and validation.',
          proof:
            'How I build structured workflows that save time and improve data quality.',
          skills: ['n8n', 'Automation', 'APIs', 'Data normalization', 'Lead generation', 'Workflow design'],
          href: '/en/projects/n8n-lead-automation/',
        },
        {
          id: '06',
          title: 'Lastsmart / Tungportalen-related tools',
          text:
            'An education and tools-oriented web project with calculators, structured content, and digital functionality for heavy transport, load, and logistics-related needs.',
          proof:
            'Ability to build clear digital tools within a specific domain.',
          skills: ['Laravel/web tools', 'Calculators', 'Content structure', 'Domain logic', 'UX'],
        },
      ],
    }
  : {
      kicker: 'Praktiska bevis',
      title: 'Projekt som visar hur jag arbetar',
      intro:
        'Vid sidan av min jobbsökning bygger jag egna digitala projekt för att utveckla och visa min praktiska kompetens inom SEO, webb, AI, automation, CMS, produktstruktur och digitala arbetsflöden. Projekten visar hur jag tar idéer från analys och struktur till fungerande lösningar.',
      labels: {
        projectType: 'Eget projekt',
        proof: 'Vad det visar',
        skills: 'Kompetenser',
        readMore: 'Öppna case',
      },
      cards: [
        {
          id: '01',
          title: 'Mystnet SaaS / AI Dashboard',
          text:
            'Ett SaaS- och dashboardprojekt där jag arbetar med Laravel, AI-stödda funktioner, kundportal-koncept, live chat/inbox, automationsflöden och produktnära UI/UX.',
          proof:
            'Min förmåga att tänka i system, flöden, användarroller och praktisk implementation.',
          skills: ['Laravel', 'SaaS', 'AI-flöden', 'UI/UX', 'Automation', 'Produkttänk'],
        },
        {
          id: '02',
          title: 'WordPress Assistant / AI Content Workflow',
          text:
            'Ett AI-stött WordPress- och Chrome extension-koncept för att hjälpa med innehåll, SEO, metadata, produkttexter och CMS-arbete.',
          proof:
            'Hur jag kombinerar SEO, WordPress, AI och praktiska redaktörsflöden.',
          skills: ['WordPress', 'SEO', 'AI', 'Chrome extension', 'CMS-flöden', 'Content operations'],
        },
        {
          id: '03',
          title: 'Withdrawal Button for WordPress',
          text:
            'Ett WordPress-plugin för att hantera ånger- och avbokningsförfrågningar med adminvy, formulär, e-postflöden, språkstöd och valfri WooCommerce-koppling.',
          proof:
            'Strukturerad pluginutveckling, användarflöden och produktionsnära tänk.',
          skills: ['WordPress-plugin', 'WooCommerce', 'Admin UX', 'E-postflöden', 'Språkstöd'],
        },
        {
          id: '04',
          title: 'Image-layer Product Visualizer',
          text:
            'Ett specialbyggt WordPress-plugin för att låta användare välja miljö och testa olika fönsterbänkar visuellt.',
          proof:
            'Arbete med bildlager, admin-editor, frontend-rendering och produktnära e-handelsfunktionalitet.',
          skills: ['WordPress', 'Visuell editor', 'Frontend-rendering', 'E-handels-UX', 'Produktkonfigurator'],
        },
        {
          id: '05',
          title: 'n8n Lead Automation',
          text:
            'Ett automationsflöde för leadgenerering med n8n, Google Sheets, API-data, normalisering, deduplicering och validering.',
          proof:
            'Hur jag bygger strukturerade arbetsflöden som sparar tid och skapar bättre datakvalitet.',
          skills: ['n8n', 'Automation', 'API:er', 'Datanormalisering', 'Leadgenerering', 'Workflow design'],
          href: '/projekt/n8n-lead-automation/',
        },
        {
          id: '06',
          title: 'Lastsmart / Tungportalen-relaterade verktyg',
          text:
            'Ett utbildnings- och verktygsinriktat webbprojekt med kalkylatorer, strukturerat innehåll och digitala funktioner för tung trafik, last och transportrelaterade behov.',
          proof:
            'Min förmåga att bygga tydliga digitala verktyg inom ett specifikt ämnesområde.',
          skills: ['Laravel/webbverktyg', 'Kalkylatorer', 'Innehållsstruktur', 'Domänlogik', 'UX'],
        },
      ],
    };
---

<section id="work" class="band band--surface" aria-labelledby="work-title">
  <header class="section-head reveal-block">
    <p class="section-kicker">{content.kicker}</p>
    <h2 id="work-title" class="section-title">{content.title}</h2>
    <p class="section-lead">{content.intro}</p>
  </header>

  <div class="mt-10 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
    {content.cards.map((card, index) => (
      <article
        class="ui-card ui-card--interactive portfolio-card reveal-card p-6 text-left"
        style={`animation-delay: ${index * 70}ms;`}
        tabindex="0"
      >
        <div class="mb-4 flex flex-wrap items-center gap-2">
          <span class="card-id inline-flex rounded-full border border-cyan-300/25 bg-cyan-300/10 px-2.5 py-1 text-[11px] font-semibold tracking-[0.16em] text-cyan-200">
            {card.id}
          </span>
          <span class="inline-flex rounded-full border border-white/10 bg-white/[0.04] px-2.5 py-1 text-[11px] font-semibold text-neutral-300">
            {content.labels.projectType}
          </span>
        </div>

        <h3 class="text-2xl font-semibold leading-tight text-white">{card.title}</h3>
        <p class="mt-3 text-sm leading-relaxed text-neutral-300">{card.text}</p>

        <div class="mt-5">
          <p class="text-xs font-semibold uppercase tracking-[0.12em] text-cyan-200">{content.labels.proof}</p>
          <p class="mt-2 text-sm leading-relaxed text-neutral-200">{card.proof}</p>
        </div>

        <div class="mt-5">
          <p class="text-xs font-semibold uppercase tracking-[0.12em] text-neutral-400">{content.labels.skills}</p>
          <div class="mt-3 flex flex-wrap gap-2" aria-label={`${content.labels.skills}: ${card.title}`}>
            {card.skills.map((skill) => (
              <span class="capability-tag">{skill}</span>
            ))}
          </div>
        </div>

        {card.href && (
          <a
            href={card.href}
            class="mt-6 inline-flex items-center text-sm font-semibold text-cyan-300 transition hover:text-cyan-200"
          >
            {content.labels.readMore}
            <span aria-hidden="true" class="ml-1">-&gt;</span>
          </a>
        )}
      </article>
    ))}
  </div>
</section>
