---
interface Props {
  lang?: 'sv' | 'en';
}

const { lang = 'sv' } = Astro.props;
const isEn = lang === 'en';

const content = isEn
  ? {
      kicker: 'Employment focus',
      title: "Roles I'm looking for",
      intro:
        'I am looking for an employed role where my broad experience across SEO, web, technical structure, analytics, CMS, automation, and AI-assisted workflows can help an employer improve digital work in practice.',
      roles: [
        'SEO Specialist / Technical SEO Specialist',
        'Web Manager / Website Manager',
        'CMS or WordPress Specialist',
        'Digital Coordinator / Growth Coordinator',
        'IT/Application Management or System Administration-related roles',
        'Product-oriented Web Developer',
        'AI and automation-oriented roles',
      ],
      contributionTitle: 'What I bring',
      contributions: [
        'Long experience in SEO, technical structure, and content strategy',
        'Hands-on experience with websites, WordPress/CMS, and digital workflows',
        'Ability to combine analysis, structure, and implementation',
        'Strong understanding of AI-assisted workflows and automation',
        'Used to taking improvements from idea to working solution',
      ],
    }
  : {
      kicker: 'Anställningsfokus',
      title: 'Roller jag söker',
      intro:
        'Jag söker en roll som anställd där min breda erfarenhet inom SEO, webb, teknisk struktur, analys, CMS, automation och AI-stödda arbetsflöden kan bidra till praktiska förbättringar hos en arbetsgivare.',
      roles: [
        'SEO-specialist / Technical SEO Specialist',
        'Webbansvarig / Web Manager',
        'CMS- eller WordPress-specialist',
        'Digital koordinator / Growth Coordinator',
        'IT-förvaltning / Systemförvaltning',
        'Produktnära webbutveckling',
        'AI- och automationsnära roller',
      ],
      contributionTitle: 'Vad jag bidrar med',
      contributions: [
        'Lång erfarenhet av SEO, teknisk struktur och innehållsstrategi',
        'Praktisk erfarenhet av webb, WordPress/CMS och digitala flöden',
        'Förmåga att kombinera analys, struktur och implementation',
        'Stark förståelse för AI-stödda arbetssätt och automation',
        'Van att driva förbättringar från idé till fungerande lösning',
      ],
    };
---

<section class="band band--surface" aria-labelledby="hiring-value-title">
  <header class="section-head reveal-block">
    <p class="section-kicker">{content.kicker}</p>
    <h2 id="hiring-value-title" class="section-title">{content.title}</h2>
    <p class="section-lead">{content.intro}</p>
  </header>

  <div class="mt-10 grid gap-5 lg:grid-cols-[0.95fr_1.05fr]">
    <article class="ui-card ui-card--interactive reveal-card p-7 text-left" tabindex="0">
      <h3 class="text-xl font-semibold text-white">{content.title}</h3>
      <ul class="mt-5 space-y-3 text-sm leading-relaxed text-neutral-200" aria-label={content.title}>
        {content.roles.map((role) => (
          <li class="card-meta">{role}</li>
        ))}
      </ul>
    </article>

    <article class="ui-card ui-card--interactive reveal-card p-7 text-left" tabindex="0">
      <h3 class="text-xl font-semibold text-white">{content.contributionTitle}</h3>
      <ul class="mt-5 space-y-3 text-sm leading-relaxed text-neutral-200" aria-label={content.contributionTitle}>
        {content.contributions.map((point) => (
          <li class="card-meta">{point}</li>
        ))}
      </ul>
    </article>
  </div>
</section>
