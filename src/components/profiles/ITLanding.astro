---
import Hero from '../home/Hero.astro';
import HiringValue from '../home/HiringValue.astro';
import BestFit from '../home/BestFit.astro';
import FeaturedWork from '../home/FeaturedWork.astro';
import Capabilities from '../home/Capabilities.astro';
import OperatingSystem from '../home/OperatingSystem.astro';
import ProofBand from '../home/ProofBand.astro';
import FAQ from '../home/FAQ.astro';
import About from '../home/About.astro';
import FinalCTA from '../home/FinalCTA.astro';

interface Props {
  lang?: 'sv' | 'en';
}

const { lang = 'sv' } = Astro.props;
---

<div class="home-shell">
  <Hero lang={lang} />
  <HiringValue lang={lang} />
  <BestFit lang={lang} />
  <FeaturedWork lang={lang} />
  <Capabilities lang={lang} />
  <OperatingSystem lang={lang} />
  <ProofBand lang={lang} />
  <FAQ lang={lang} />
  <About lang={lang} />
  <FinalCTA lang={lang} />
</div>
