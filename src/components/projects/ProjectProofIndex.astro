const projectPath = isEn ? '/en/projects' : '/projekt';
const overrides = content.overrides as Record<string, Partial<ProofItem>>;
const personalItems = content.personalProjects as ProofItem[];

const collectionItems: ProofItem[] = projects.map((project) => {
  const override = overrides[project.slug] ?? {};

  return {
    id: project.slug,
    title: project.data.title,
    summary: override.summary ?? project.data.excerpt,
    demonstrates:
      override.demonstrates ??
      (isEn
        ? 'Shows practical work across structure, implementation, technical quality, and digital improvement.'
        : 'Visar praktiskt arbete med struktur, implementation, teknisk kvalitet och digital förbättring.'),
    skills: override.skills ?? [...project.data.stack, ...project.data.tags],
    tracks:
      override.tracks ??
      (isEn ? ['Web/CMS', 'IT/Web management'] : ['Webb/CMS', 'IT-förvaltning']),
    href: `${projectPath}/${project.slug}/`,
    liveUrl: project.data.liveUrl,
    featured: project.data.featured,
    priority: override.priority ?? 100,
  };
});

const proofItems = [...personalItems, ...collectionItems].sort((a, b) => {
  if (a.priority !== b.priority) return a.priority - b.priority;
  return a.title.localeCompare(b.title, isEn ? 'en' : 'sv');
});
---

<section class="band band--surface" aria-labelledby="projects-title">
  <header class="section-head reveal-block">
    <p class="section-kicker">{isEn ? 'Project proof' : 'Projektbevis'}</p>
    <h1 id="projects-title" class="section-title">{content.title}</h1>
    <p class="section-lead">{content.intro}</p>
  </header>

  <article class="ui-card mt-8 p-6 text-left">
    <p class="text-xs font-semibold uppercase tracking-[0.14em] text-cyan-300">{content.trackTitle}</p>
    <p class="mt-3 text-sm leading-relaxed text-neutral-300">{content.trackText}</p>
  </article>

  <div class="mt-10 grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-3">
    {proofItems.map((project) => (
      <article class="ui-card ui-card--interactive flex h-full flex-col p-6 text-left" tabindex="0">
        <div class="flex flex-wrap items-center gap-2">
          {project.tracks.slice(0, 2).map((track) => (
            <span class="rounded-full border border-white/15 bg-white/5 px-2.5 py-1 text-xs text-neutral-200">{track}</span>
          ))}
        </div>

        <h2 class="mt-4 text-xl font-semibold leading-tight text-white">{project.title}</h2>
        <p class="mt-3 text-sm leading-relaxed text-neutral-300">{project.summary}</p>

        <div class="mt-5">
          <p class="text-xs font-semibold uppercase tracking-[0.12em] text-cyan-200">{content.labels.demonstrates}</p>
          <p class="mt-2 text-sm leading-relaxed text-neutral-200">{project.demonstrates}</p>
        </div>

        <div class="mt-5">
          <p class="text-xs font-semibold uppercase tracking-[0.12em] text-neutral-400">{content.labels.skills}</p>
          <div class="mt-3 flex flex-wrap gap-2" aria-label={`${content.labels.skills}: ${project.title}`}>
            {project.skills.map((skill) => (
              <span class="capability-tag">{skill}</span>
            ))}
          </div>
        </div>

        <div class="mt-5">
          <p class="text-xs font-semibold uppercase tracking-[0.12em] text-neutral-400">{content.labels.tracks}</p>
          <div class="mt-3 flex flex-wrap gap-2" aria-label={`${content.labels.tracks}: ${project.title}`}>
            {project.tracks.map((track) => (
              <span class="capability-tag">{track}</span>
            ))}
          </div>
        </div>

        {(project.href || project.liveUrl) && (
          <div class="mt-auto flex flex-wrap gap-3 pt-6">
            {project.href && (
              <a href={project.href} class="inline-flex text-sm font-semibold text-cyan-300 transition hover:text-cyan-200">
                {content.labels.read}
              </a>
            )}
            {project.liveUrl && (
              <a
                href={project.liveUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex text-sm font-semibold text-cyan-300 transition hover:text-cyan-200"
              >
                {content.labels.visit} <span aria-hidden="true">↗</span>
              </a>
            )}
          </div>
        )}
      </article>
    ))}
  </div>
</section>
