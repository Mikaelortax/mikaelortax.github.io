---
interface ProjectEntry {
  slug: string;
  data: {
    title: string;
    excerpt: string;
    tags: string[];
    stack: string[];
    liveUrl?: string;
    featured?: boolean;
  };
}

interface ProofItem {
  id: string;
  title: string;
  summary: string;
  demonstrates: string;
  skills: string[];
  tracks: string[];
  href?: string;
  liveUrl?: string;
  featured?: boolean;
  priority: number;
}

interface Props {
  lang?: 'sv' | 'en';
  projects: ProjectEntry[];
}

