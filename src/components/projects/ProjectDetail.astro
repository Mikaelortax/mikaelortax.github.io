---
interface Props {
  lang?: 'sv' | 'en';
  title: string;
  excerpt: string;
  role: string;
  stack: string[];
  tags: string[];
  outcomes: string[];
  liveUrl?: string;
  repoUrl?: string;
  caseImage?: string;
  projectType?: string;
  skills?: string[];
  tracks?: string[];
  purpose?: string;
  myRole?: string;
  keyParts?: string[];
  methods?: string[];
  demonstrates?: string;
  employmentRelevance?: string;
  screenshots?: {
    label: string;
    src?: string;
    alt?: string;
  }[];
  backHref: string;
  backLabel: string;
  contactHref: string;
  contactLabel: string;
  ctaTitle: string;
  ctaText: string;
}

const {
  lang = 'sv',
  title,
  excerpt,
  role,
  stack,
  tags,
  outcomes,
  liveUrl,
  repoUrl,
  caseImage,
  projectType,
  skills,
  tracks,
  purpose,
  myRole,
  keyParts,
  methods,
  demonstrates,
  employmentRelevance,
  screenshots,
  backHref,
  backLabel,
  contactHref,
  contactLabel,
  ctaTitle,
  ctaText,
} = Astro.props;

const labels =
  lang === 'en'
    ? {
        overview: 'Overview',
        projectType: 'Project type',
        skills: 'Skills',
        tracks: 'Supports roles within',
        purpose: 'Problem / purpose',
        myRole: 'My role',
        keyParts: 'Solution / key parts',
        methods: 'Technology and methods',
        screenshots: 'Screenshots',
        screenshotHint: 'Screenshot coming soon',
        demonstrates: 'What this project demonstrates',
        relevance: 'Relevance for roles',
        visit: 'Visit live site',
        source: 'View source',
        fallbackType: 'Project',
        fallbackPurpose:
          'The project shows practical work with structure, implementation, technical quality, and digital improvement.',
        fallbackDemonstrates:
          'The project demonstrates my ability to connect analysis, structure, implementation, and follow-up in practical digital work.',
        fallbackRelevance:
          'It supports roles where web, SEO, structure, implementation, and reliable digital workflows need to work together.',
      }
    : {
        overview: 'Översikt',
        projectType: 'Projekttyp',
        skills: 'Kompetenser',
        tracks: 'Stärker roller inom',
        purpose: 'Problem / syfte',
        myRole: 'Min roll',
        keyParts: 'Lösning / viktiga delar',
        methods: 'Teknik och metoder',
        screenshots: 'Skärmbilder',
        screenshotHint: 'Skärmbild kommer',
        demonstrates: 'Vad projektet visar',
        relevance: 'Relevans för roller',
        visit: 'Besök live-sajt',
        source: 'Visa källkod',
        fallbackType: 'Projekt',
        fallbackPurpose:
          'Projektet visar praktiskt arbete med struktur, implementation, teknisk kvalitet och digital förbättring.',
        fallbackDemonstrates:
          'Projektet visar min förmåga att koppla ihop analys, struktur, implementation och uppföljning i praktiskt digitalt arbete.',
        fallbackRelevance:
          'Det stärker roller där webb, SEO, struktur, implementation och stabila digitala arbetsflöden behöver fungera tillsammans.',
      };

const fallbackImage = caseImage
  ? caseImage.endsWith('.jpg')
    ? caseImage.replace(/\.jpg$/, '.png')
    : caseImage.endsWith('.jpeg')
      ? caseImage.replace(/\.jpeg$/, '.png')
      : caseImage.endsWith('.png')
        ? caseImage.replace(/\.png$/, '.jpg')
        : undefined
  : undefined;

const skillList = skills?.length ? skills : [...stack, ...tags];
const trackList = tracks?.length ? tracks : tags;
const keyPartList = keyParts?.length ? keyParts : outcomes;
const methodList = methods?.length ? methods : [...stack, ...tags];
const displayProjectType = projectType || labels.fallbackType;
const displayPurpose = purpose || labels.fallbackPurpose;
const displayRole = myRole || role;
const displayDemonstrates = demonstrates || labels.fallbackDemonstrates;
const displayRelevance = employmentRelevance || labels.fallbackRelevance;
const screenshotItems =
  screenshots?.length
    ? screenshots
    : caseImage
      ? [{ label: labels.overview, src: caseImage, alt: `${title} case preview` }]
      : [
          { label: lang === 'en' ? 'Dashboard view' : 'Dashboardvy' },
          { label: lang === 'en' ? 'Workflow or module' : 'Flöde eller modul' },
          { label: lang === 'en' ? 'Detail view' : 'Detaljvy' },
        ];

---

<article class="space-y-8" aria-labelledby="project-title">
  <section class="band band--mesh">
    <div class="mx-auto max-w-6xl">
      <a href={backHref} class="inline-flex text-sm font-semibold text-cyan-300 transition hover:text-cyan-200">{backLabel}</a>

      <div class="mt-6 grid gap-6 lg:grid-cols-12 lg:items-start">
        <div class="lg:col-span-8">
          <div class="flex flex-wrap gap-2">
            <span class="rounded-full border border-cyan-300/35 bg-cyan-300/10 px-3 py-1 text-xs font-semibold text-cyan-100">
              {displayProjectType}
            </span>
            {trackList.slice(0, 3).map((track) => (
              <span class="rounded-full border border-white/15 bg-white/5 px-3 py-1 text-xs text-neutral-200">{track}</span>
            ))}
          </div>
          <h1 id="project-title" class="text-3xl font-semibold tracking-tight text-white md:text-5xl">{title}</h1>
          <p class="mt-4 max-w-3xl text-base leading-relaxed text-neutral-300 md:text-lg">{excerpt}</p>

          <div class="mt-6 flex flex-wrap gap-2" aria-label={`${labels.skills}: ${title}`}>
            {skillList.slice(0, 8).map((skill) => (
              <span class="capability-tag">{skill}</span>
            ))}
          </div>
        </div>

        <aside class="lg:col-span-4">
          <article class="ui-card p-5 text-left">
            <p class="text-xs uppercase tracking-[0.14em] text-cyan-300">{labels.tracks}</p>
            <div class="mt-3 flex flex-wrap gap-2">
              {trackList.map((track) => (
                <span class="capability-tag">{track}</span>
              ))}
            </div>
          </article>
        </aside>
      </div>

      <div class="mt-8 grid grid-cols-1 gap-4 md:grid-cols-2">
        <article class="ui-card ui-card--interactive p-5 text-left">
          <h2 class="text-lg font-semibold text-white">{labels.purpose}</h2>
          <p class="mt-3 text-sm leading-relaxed text-neutral-300">{displayPurpose}</p>
        </article>
        <article class="ui-card ui-card--interactive p-5 text-left">
          <h2 class="text-lg font-semibold text-white">{labels.myRole}</h2>
          <p class="mt-3 text-sm leading-relaxed text-neutral-300">{displayRole}</p>
        </article>
      </div>

      <section class="mt-8 grid gap-4 lg:grid-cols-[1.05fr_0.95fr]" aria-labelledby="solution-title">
        <article class="ui-card ui-card--interactive p-5 text-left">
          <h2 id="solution-title" class="text-lg font-semibold text-white">{labels.keyParts}</h2>
          <ul class="mt-4 grid gap-3 text-sm text-neutral-200 sm:grid-cols-2">
            {keyPartList.map((part) => (
              <li class="card-meta">{part}</li>
            ))}
          </ul>
        </article>
        <article class="ui-card ui-card--interactive p-5 text-left">
          <h2 class="text-lg font-semibold text-white">{labels.methods}</h2>
          <div class="mt-3 flex flex-wrap gap-2">
            {methodList.map((method) => (
              <span class="capability-tag">{method}</span>
            ))}
          </div>
        </article>
      </section>

      <section class="mt-8" aria-labelledby="screenshots-title">
        <h2 id="screenshots-title" class="text-lg font-semibold text-white">{labels.screenshots}</h2>
        <div class="mt-4 grid gap-4 md:grid-cols-3">
          {screenshotItems.map((item) => (
            <article class="ui-card p-4 text-left">
              <p class="text-xs uppercase tracking-[0.14em] text-cyan-300">{item.label}</p>
              {item.src ? (
                <img
                  src={item.src}
                  alt={item.alt || `${title} ${item.label}`}
                  loading="lazy"
                  data-fallback={fallbackImage}
                  onerror="if (this.dataset.fallbackTried === '1') return; this.dataset.fallbackTried = '1'; if (this.dataset.fallback) { this.src = this.dataset.fallback; }"
                  class="mt-3 aspect-[16/10] w-full rounded-xl border border-white/10 object-cover"
                />
              ) : (
                <div class="mt-3 flex aspect-[16/10] w-full items-center justify-center rounded-xl border border-dashed border-white/20 bg-white/[0.03] p-4 text-center text-xs font-semibold text-neutral-400">
                  {labels.screenshotHint}
                </div>
              )}
            </article>
          ))}
        </div>
      </section>

      <section class="mt-8 grid gap-4 md:grid-cols-2" aria-labelledby="demonstrates-title">
        <article class="ui-card ui-card--interactive p-5 text-left">
          <h2 id="demonstrates-title" class="text-lg font-semibold text-white">{labels.demonstrates}</h2>
          <p class="mt-3 text-sm leading-relaxed text-neutral-300">{displayDemonstrates}</p>
        </article>
        <article class="ui-card ui-card--interactive p-5 text-left">
          <h2 class="text-lg font-semibold text-white">{labels.relevance}</h2>
          <p class="mt-3 text-sm leading-relaxed text-neutral-300">{displayRelevance}</p>
        </article>
      </section>

      <section class="prose prose-invert mt-10 max-w-none rounded-2xl border border-white/10 bg-white/[0.02] p-6 md:p-8 prose-headings:text-white prose-p:text-neutral-300 prose-strong:text-white prose-a:text-cyan-300 hover:prose-a:text-cyan-200">
        <slot />
      </section>
    </div>
  </section>

  <section class="band band--surface seam-top" aria-label="Project contact call-to-action">
    <h2 class="text-2xl font-semibold tracking-tight text-white md:text-3xl">{ctaTitle}</h2>
    <p class="mt-4 max-w-2xl text-neutral-300">{ctaText}</p>
    <div class="mt-6 flex flex-wrap justify-center gap-3">
      <a href={contactHref} class="btn-primary inline-flex rounded-xl px-5 py-3 text-sm font-semibold text-neutral-950 transition">
        {contactLabel}
      </a>
      {liveUrl && (
        <a
          href={liveUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-secondary inline-flex items-center gap-2 rounded-xl px-5 py-3 text-sm"
        >
          {labels.visit}
          <span aria-hidden="true">↗</span>
        </a>
      )}
    </div>
  </section>
</article>
