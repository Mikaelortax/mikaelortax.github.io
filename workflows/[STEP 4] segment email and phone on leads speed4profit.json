      "id": "395a87b4-cdf6-4dd8-9b61-d79249bd3cbc",
      "retryOnFail": true
    },
    {
      "parameters": {
        "functionCode": "const original = $input.item?.json || {}; // From SplitInBatches\nconst parsed = $input.other?.item?.json || {}; // From Extract Email/Phone\n\nreturn [{\n  json: {\n    id: original.id || null,\n    name: original.name || null,\n    assigned: original.assigned || null,\n    source: original.source || null,\n    status: \"Segmented\",\n    email: parsed.email || original.email || null,\n    phone: parsed.phone || original.phone || null,\n    website: original.website || null,\n    company: original.company || null\n  }\n}];\n"
      },
