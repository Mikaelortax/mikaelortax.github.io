      "name": "Scrape Page",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 2,
      "position": [
        1440,
        -128
      ],
      "id": "e180b99a-1d21-45e5-97fc-2eec6ab5e3f4",
