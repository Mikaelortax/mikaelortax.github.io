    {
      "parameters": {
        "functionCode": "const base = $json.website?.replace(/\\/$/, '') || '';\n\nconst urls = [\n  '/', '/contact', '/about', '/about-us', '/aboutus',\n  '/om', '/om-oss', '/kontakt', '/startpage', '/kontakta'\n];\n\nreturn urls.map(path => ({\n  json: {\n    url: base + path,\n    lead: $json // 👈 Store the entire original lead object here\n  }\n}));\n"
      },
      "name": "Build URL Variants",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        1136,
        -128
      ],
      "id": "8b5f91c4-1a52-4d35-829e-afc34a0cc7df"
